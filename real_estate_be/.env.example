# ── Môi trường ──────────────────────────────
# Bản sao file này -> .env và điền giá trị thật.
# .env đã bị gitignore, KHÔNG commit .env lên git.

# ── AI (Gemini free tier) ───────────────────
RE_AI_API_KEY=your-gemini-api-key
RE_AI_MODEL=gemini-2.0-flash

# ── R2 (Cloudflare) ─────────────────────────
RE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
RE_R2_REGION=auto
RE_R2_ACCESS_KEY_ID=your-access-key-id
RE_R2_SECRET_ACCESS_KEY=your-secret-access-key
RE_R2_BUCKET=real-estate-files
RE_R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ── Cổng thanh toán (đặt cọc escrow) ────────
# Để trống tmn_code/hash_secret → hệ thống dùng cổng MOCK để test toàn bộ luồng.
RE_PAYMENT_VNPAY_TMN_CODE=
RE_PAYMENT_VNPAY_HASH_SECRET=

# Email tài khoản được nâng quyền ADMIN khi khởi động
RE_ADMIN_EMAIL=
